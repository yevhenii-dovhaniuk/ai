# Caddy: HTTPS-сертифікат Let's Encrypt отримується й оновлюється автоматично.
# Потрібно: домен (напр. безкоштовний DuckDNS) вказує на вашу IP, порти 80 і 443 відкриті.
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy ai:3000 {
		# віддавати токени моделі одразу, без буферизації (SSE-стрімінг)
		flush_interval -1
	}
}
