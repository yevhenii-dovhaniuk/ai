{
  "name": "ai",
  "version": "0.1.0",
  "private": true,
  "description": "Власна LLM з нуля на TypeScript + сервер + простий веб-клієнт",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "node scripts/build-web.ts --watch",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "node scripts/build-web.ts",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
