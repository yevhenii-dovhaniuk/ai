# Скопіюйте у .env і заповніть:  cp .env.example .env
# Node читає .env сам (--env-file-if-exists), додаткові пакети не потрібні.

# --- мережа ---
# 0.0.0.0 = слухати на всіх інтерфейсах (потрібно для доступу з телефона / інтернету)
# 127.0.0.1 = лише цей комп'ютер
HOST=0.0.0.0
PORT=3000

# --- безпека ---
# Токен доступу до API. Обов'язково для сервера, відкритого в інтернет!
# Згенерувати: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Якщо порожньо, сервер згенерує випадковий токен при старті й надрукує його в лог.
ACCESS_TOKEN=

# Скільки запитів до моделі на хвилину дозволено з однієї IP-адреси
RATE_LIMIT_PER_MINUTE=30

# true, якщо сервер стоїть за reverse proxy (Caddy/nginx/Cloudflare):
# тоді реальна IP клієнта береться з заголовка X-Forwarded-For
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info

# --- модель ---
# Текст, на якому вчиться чернетка моделі при старті
CORPUS_PATH=data/corpus.txt
# Порядок n-gram чернетки: скільки символів контексту (n-1) бачить модель
NGRAM_ORDER=5

# --- docker compose (лише для профілю https) ---
# Ваш домен, напр. myai.duckdns.org. Caddy сам отримає HTTPS-сертифікат.
DOMAIN=
# Куди публікувати порт контейнера. З Caddy: 127.0.0.1:3000 (назовні лише 80/443)
AI_PUBLISH=3000
